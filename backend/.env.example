# Server & Database Configuration
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/innovatex_db?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# AI Assessment Service (Anthropic Claude)
# Required for automated AI evaluation of submissions (POST /api/scores/ai/:submissionId)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional: GitHub Personal Access Token for fetching README files from public repositories
GITHUB_TOKEN=your_github_personal_access_token_here

# Semantic Similarity Detection Service
# Choose either Voyage AI (preferred for voyage-3) OR OpenAI for embeddings.
# Option A: Voyage AI
VOYAGE_API_KEY=your_voyage_api_key_here
VOYAGE_MODEL=voyage-3

# Option B: OpenAI Embeddings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Default threshold for flagging similar submissions (default: 0.8)
SIMILARITY_THRESHOLD=0.8
